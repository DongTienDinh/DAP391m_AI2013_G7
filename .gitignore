# --- Data & Artifacts ---
# Ignore all processed data and raw Olist data (downloaded via script)
data/processed/
data/raw/olist/

# Keep external data (IBGE, GeoJSON) as they are foundational and small
# !data/external/

# Ignore pipeline outputs and generated reports
outputs/
reports/

# CatBoost generated info
catboost_info/

# --- IDEs ---
.idea/
.vscode/
*.swp
*.swo

# --- Logs ---
logs/
*.log

# --- Secrets ---
.env

# --- Notebook Artifacts ---
# Ignore specific artifacts often generated in notebooks
notebooks/*.csv
notebooks/*.png
notebooks/*.json
notebooks/.ipynb_checkpoints/
