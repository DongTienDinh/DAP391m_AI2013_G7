<body>
    <div id="map-container">
        <div id="plotly-map"></div>
        <div id="zoom-controls">
            <button class="zoom-btn" id="zoom-in" title="Zoom In">+</button>
            <div class="zoom-divider"></div>
            <button class="zoom-btn" id="zoom-out" title="Zoom Out">−</button>
        </div>
    </div>
    <script>
        function sendMessageToStreamlitClient(type, data) {
            try {
                const outData = Object.assign({
                    isStreamlitMessage: true,
                    type: type,
                }, data);
                window.parent.postMessage(outData, "*");
            } catch (err) {
                console.log("[MapComponent] Error postMessage: " + err.message);
            }
        }

        try {
            sendMessageToStreamlitClient("streamlit:componentReady", { apiVersion: 1 });
        } catch (err) {
            console.log("[MapComponent] Init error: " + err.message);
        }

        var currentFigJson = null;
        var plotDiv = document.getElementById('plotly-map');

        // Helper: find the map zoom key in the layout (handles both 'map' and 'mapbox')
        function getMapKey(layout) {
            if (layout.map) return 'map';
            if (layout.mapbox) return 'mapbox';
            return 'map';
        }

        // Zoom controls
        document.getElementById('zoom-in').addEventListener('click', function() {
            var layout = plotDiv._fullLayout;
            var key = getMapKey(layout);
            if (layout && layout[key]) {
                var currentZoom = layout[key].zoom || 3;
                var relayoutObj = {};
                relayoutObj[key + '.zoom'] = Math.min(currentZoom + 0.7, 12);
                Plotly.relayout(plotDiv, relayoutObj);
            }
        });

        document.getElementById('zoom-out').addEventListener('click', function() {
            var layout = plotDiv._fullLayout;
            var key = getMapKey(layout);
            if (layout && layout[key]) {
                var currentZoom = layout[key].zoom || 3;
                var relayoutObj = {};
                relayoutObj[key + '.zoom'] = Math.max(currentZoom - 0.7, 1.5);
                Plotly.relayout(plotDiv, relayoutObj);
            }
        });

        // Listen for data from Streamlit
        window.addEventListener("message", function(event) {
            try {
                if (event.data && event.data.type === "streamlit:render") {
                    var args = event.data.args;
                    if (args && args.fig_json) {
                        if (args.fig_json === currentFigJson) {
                            return;
                        }
                        currentFigJson = args.fig_json;
                        var figData = JSON.parse(args.fig_json);

                        // Override to light/bright map style
                        figData.layout.paper_bgcolor = '#f0f4f8';
                        figData.layout.plot_bgcolor = '#f0f4f8';
                        figData.layout.clickmode = 'event+select';
                        figData.layout.dragmode = 'pan';

                        Plotly.newPlot(plotDiv, figData.data, figData.layout, {
                            displayModeBar: false,
                            responsive: true,
                            scrollZoom: true
                        }).then(function() {
                            // Set iframe height dynamically from layout, default to 520
                            sendMessageToStreamlitClient("streamlit:setFrameHeight", {
                                height: figData.layout.height || 520
                            });

                            // Bind native click handler
                            plotDiv.on('plotly_click', function(clickData) {
                                try {
                                    if (clickData && clickData.points && clickData.points.length > 0) {
                                        var point = clickData.points[0];
                                        var stateCode = null;
                                        // Resolve from choropleth customdata or text-label fallback
                                        if (point.customdata && point.customdata.length > 0) {
                                            stateCode = point.customdata[0];
                                        } else if (point.text && point.text.length === 2) {
                                            stateCode = point.text;
                                        }
                                        if (stateCode && stateCode.length === 2) {
                                            sendMessageToStreamlitClient("streamlit:setComponentValue", {
                                                value: {
                                                    state: stateCode,
                                                    timestamp: Date.now()
                                                }
                                            });
                                        }
                                    }
                                } catch (clickErr) {
                                    console.log("[MapComponent] Click error: " + clickErr.message);
                                }
                            });
                        }).catch(function(plotErr) {
                            console.log("[MapComponent] Plotly error: " + plotErr.message);
                        });
                    }
                }
            } catch (err) {
                console.log("[MapComponent] Render error: " + err.message);
            }
        });
    </script>
