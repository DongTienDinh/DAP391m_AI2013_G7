    and the risk adjustment factor (line) across states.
    """
    fig = make_subplots(specs=[[{"secondary_y": True}]])
    
    # Sort descending by EPS_score
    df_sorted = df.sort_values("EPS_score", ascending=False)
    x_labels = df_sorted['state_display']
    
